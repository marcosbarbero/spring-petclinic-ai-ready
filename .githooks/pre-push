#!/usr/bin/env bash
# The local gate. Everything CI would tell you in twelve minutes, told to you in ten
# seconds, before anything leaves this machine and before a reviewer's afternoon is spent.
#
# Enable once per clone:   git config core.hooksPath .githooks
#
# There is deliberately no fast path. If you need --no-verify, you need a smaller change.

set -uo pipefail

RED=$'\033[31m'; GREEN=$'\033[32m'; YELLOW=$'\033[33m'; BOLD=$'\033[1m'; OFF=$'\033[0m'
start=$(date +%s)

# Docker-dependent tests are excluded from the default build in pom.xml, so the local
# gate is fast and needs no Docker. CI runs them via -Pcontainers.

step() { printf '\n%s▶ %s%s\n' "$BOLD" "$1" "$OFF"; }
fail() {
  printf '\n%s%s✗ PUSH REJECTED — %s%s\n' "$BOLD" "$RED" "$1" "$OFF"
  printf '%s  Nothing left this machine. Fix it and push again.%s\n\n' "$RED" "$OFF"
  exit 1
}

cd "$(git rev-parse --show-toplevel)" || exit 1

step "1/5  formatting"
./mvnw -q spring-javaformat:validate \
  || fail "formatting (fix: ./mvnw spring-javaformat:apply)"

step "2/5  lint"
./mvnw -q checkstyle:check@nohttp-checkstyle-validation \
  || fail "lint / nohttp"
./mvnw -q checkstyle:check@quality-checkstyle-validation \
  || fail "lint / code quality (magic numbers, complexity, injection surface)"

step "3/5  tool registry + architecture rules"
.claude/tools/tool_mapping.py check \
  || fail "tool registry drift — an unregistered tool is an undiscoverable tool"

./mvnw -q test -Dtest='ArchitectureRulesTest' -Dsurefire.failIfNoSpecifiedTests=false \
  || fail "architecture rules — you crossed a package boundary"

step "4/5  tests + coverage gate"
./mvnw -q verify \
  || fail "tests or coverage threshold (line 90% / branch 78%)"

if [ "${SKIP_MUTATION:-0}" = "1" ]; then
  printf '\n%s⚠ 5/5  mutation testing SKIPPED (SKIP_MUTATION=1)%s\n' "$YELLOW" "$OFF"
else
  step "5/5  mutation score"
  ./mvnw -q -Pmutation verify \
    || fail "mutation score below 80% — your tests run the code but do not check it"
fi

printf '\n%s%s✓ all gates green in %ss — pushing%s\n\n' "$BOLD" "$GREEN" "$(( $(date +%s) - start ))" "$OFF"
